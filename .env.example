# Create a key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Primary free hosted model. If it fails, Codarox AI automatically falls back
# to NVIDIA Nemotron 3 Ultra (free). No local model is required.
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

PORT=8787
APP_NAME=Codarox AI

# Gemma 4 26B context window used by the UI safety meter
CONTEXT_LIMIT=262144
